rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== REGLAS EXISTENTES (NO MODIFICAR) =====
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /mascotas/{petId} {
      allow read, write: if request.auth != null && 
                           request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
      
      match /vacunaciones/{vaccinationId} {
        allow read, write: if request.auth != null;
      }
      
      match /desparasitaciones/{dewormingId} {
        allow read, write: if request.auth != null;
      }
      
      match /examenesAnuales/{examId} {
        allow read, write: if request.auth != null;
      }
    }
    
    match /eventos/{eventId} {
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && 
                              request.auth.uid == resource.data.userId;
    }
    
    match /notificaciones/{notificationId} {
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.recipientId;
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.recipientId;
    }
    
    match /memorialPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && 
                              request.auth.uid == resource.data.userId;
    }
    
    // ===== NUEVAS REGLAS AGREGADAS =====
    
    // Permitir a usuarios autenticados actualizar likes y comentarios
    match /memorialPosts/{postId} {
      // Permitir update si solo se modifican likes, likedBy o comments
      allow update: if request.auth != null && (
        // Usuario puede actualizar su propio post
        request.auth.uid == resource.data.userId ||
        // O cualquier usuario puede dar like/comentar
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'likedBy', 'comments', 'updatedAt'])
        )
      );
    }
    
    // Colección de notificaciones (alternativa al typo "notificaciones")
    match /notifications/{notificationId} {
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.recipientId;
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.recipientId;
    }
  }
}
